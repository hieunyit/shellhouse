{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.compat.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/session-host/**/*",
    "src/node-shared/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "test/unit/**/*",
    "test/integration/**/*",
    "test/compat/**/*",
    "test/fuzz/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
