{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.compat.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/session-host/**/*",
    "src/node-shared/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/modules/registry/types.ts",
    "src/modules/registry/search.ts",
    "src/modules/registry/manifests.ts",
    "src/modules/registry/main*.ts",
    "src/modules/registry/all-main.ts",
    "src/modules/registry/all-host.ts",
    "src/modules/registry/host-types.ts",
    "src/modules/registry/session-host.ts",
    "src/modules/registry/local-paths.ts",
    "src/modules/*/manifest.ts",
    "src/modules/*/shared/**/*",
    "src/modules/*/main/**/*",
    "src/modules/*/session-host/**/*",
    "src/modules/*/test/unit/**/*",
    "src/modules/*/test/integration/**/*",
    "src/modules/*/test/*-server.ts",
    "src/modules/k8s/test/hubble-flows.ts",
    "test/unit/**/*",
    "test/integration/**/*",
    "test/compat/**/*",
    "test/fuzz/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
