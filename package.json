{
  "name": "shellhouse",
  "version": "1.2.0-beta.19",
  "private": true,
  "description": "SSH & terminal client",
  "homepage": "https://github.com/hieunyit/shellhouse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hieunyit/shellhouse.git"
  },
  "bugs": {
    "url": "https://github.com/hieunyit/shellhouse/issues"
  },
  "desktopName": "shellhouse.desktop",
  "main": "./out/main/index.js",
  "author": "hieuny",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "rebuild:native": "electron-rebuild --force --only node-pty",
    "package": "electron-vite build && electron-builder --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "bench": "playwright test --project=bench",
    "fuzz": "FUZZ_RUNS=50000 vitest run test/fuzz",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "soak": "playwright test --project=soak",
    "test:package": "playwright test --project=package",
    "screens": "playwright test --project=screens"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
