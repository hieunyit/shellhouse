    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.48.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "s3rver": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
